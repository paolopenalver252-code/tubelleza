---
import Icon from './Icon.astro';

interface Props {
  title?: string;
  links: { href: string; label: string; text: string }[];
}
const { title = 'Siga explorando', links } = Astro.props;
---

<nav class="related section-tight bg-ivory" aria-label={title}>
  <div class="wrap">
    <p class="eyebrow">{title}</p>
    <ul>
      {
        links.map((l) => (
          <li>
            <a href={l.href}>
              <span class="label">{l.label}</span>
              <span class="text">{l.text}</span>
              <span class="arrow" aria-hidden="true"><Icon name="arrow" size={18} /></span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style>
  ul {
    list-style: none;
    display: grid;
    margin-top: 1.5rem;
    border-top: 1px solid var(--line-strong);
  }

  li {
    border-bottom: 1px solid var(--line);
  }

  a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 1.5rem;
    align-items: center;
    padding-block: 1.35rem;
    text-decoration: none;
  }

  .label {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    line-height: 1.1;
    transition: color 0.25s var(--ease);
  }

  .text {
    grid-row: 2;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .arrow {
    grid-row: 1 / span 2;
    grid-column: 2;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition:
      background-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }

  a:hover .label {
    color: var(--olive-600);
  }

  a:hover .arrow {
    background: var(--forest-900);
    color: var(--on-dark);
  }

  @media (min-width: 900px) {
    ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 2.5rem;
      border-top: 0;
    }
    li {
      border-top: 1px solid var(--line-strong);
    }
  }
</style>
