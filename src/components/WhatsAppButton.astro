---
import Icon from './Icon.astro';
import { whatsappLink } from '@/data/site';
---

<a
  class="wa-float"
  href={whatsappLink()}
  target="_blank"
  rel="noopener"
  aria-label="Reservar por WhatsApp (se abre WhatsApp con un mensaje preparado)"
>
  <span class="wa-icon"><Icon name="whatsapp" size={24} /></span>
  <span class="wa-label" aria-hidden="true">Reservar por WhatsApp</span>
</a>

<style>
  /* Siempre visible abajo a la derecha. El verde de WhatsApp solo en el círculo: se reconoce sin romper la paleta. */
  .wa-float {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 45;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.4rem;
    border-radius: 999px;
    background: var(--forest-900);
    color: var(--on-dark);
    text-decoration: none;
    box-shadow:
      0 10px 30px -12px rgb(20 26 18 / 0.55),
      0 0 0 1px rgb(243 239 229 / 0.12);
    transition:
      transform 0.3s var(--ease),
      background-color 0.3s var(--ease);
  }

  .wa-float:hover {
    background: var(--olive-700);
    transform: translateY(-2px);
  }

  .wa-float:focus-visible {
    outline: 2px solid var(--clay-500);
    outline-offset: 3px;
  }

  .wa-icon {
    display: grid;
    place-items: center;
    width: 3.1rem;
    height: 3.1rem;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
  }

  .wa-label {
    display: none;
    padding-right: 1rem;
    font-size: 0.92rem;
    font-weight: 600;
    white-space: nowrap;
  }

  @media (min-width: 760px) {
    .wa-float {
      right: 1.5rem;
      bottom: 1.5rem;
    }
    .wa-label {
      display: inline;
    }
  }
</style>
