---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  src: string;
  poster: ImageMetadata;
  label: string;
  duration: string;
}

const { src, poster, label, duration } = Astro.props;
// Póster ligero; el vídeo no se descarga hasta que la persona pulsa reproducir.
const posterImg = await getImage({ src: poster, width: 540, format: 'webp', quality: 70 });
---

<figure class="video" data-video>
  <div class="frame">
    <video
      src={src}
      poster={posterImg.src}
      preload="none"
      playsinline
      controls={false}
      aria-label={label}
      width="540"
      height="960"
    ></video>
    <button class="play" type="button" data-video-play>
      <span class="play-icon"><Icon name="play" size={22} /></span>
      <span class="play-label">Ver vídeo <span class="dur">{duration}</span></span>
    </button>
  </div>
  <figcaption class="caption">{label}. Vídeo publicado por el centro en sus redes; incluye sonido.</figcaption>
</figure>

<style>
  .video {
    margin: 0;
  }

  .frame {
    position: relative;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--forest-950);
  }

  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .play {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    width: 100%;
    border: 0;
    background: linear-gradient(0deg, rgb(20 26 18 / 0.55), rgb(20 26 18 / 0.1));
    color: var(--on-dark);
    cursor: pointer;
  }

  .play-icon {
    display: grid;
    place-items: center;
    width: 4.25rem;
    height: 4.25rem;
    padding-left: 4px;
    border: 1px solid rgb(243 239 229 / 0.6);
    border-radius: 50%;
    background: rgb(20 26 18 / 0.35);
    backdrop-filter: blur(6px);
    transition:
      transform 0.3s var(--ease),
      background-color 0.3s var(--ease);
  }

  .play:hover .play-icon {
    transform: scale(1.06);
    background: rgb(20 26 18 / 0.6);
  }

  .play-label {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .dur {
    opacity: 0.7;
    font-weight: 500;
    margin-left: 0.25rem;
  }

  .is-playing .play {
    display: none;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((root) => {
    const video = root.querySelector('video');
    const button = root.querySelector<HTMLButtonElement>('[data-video-play]');
    if (!video || !button) return;
    button.addEventListener('click', () => {
      root.classList.add('is-playing');
      video.controls = true;
      video.play().catch(() => {
        root.classList.remove('is-playing');
      });
      video.focus();
    });
  });
</script>
