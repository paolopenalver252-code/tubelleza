---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  title: string;
  /** Parte del título en cursiva, en una segunda línea. */
  accent?: string;
  intro: string;
  image: ImageMetadata;
  alt: string;
  position?: string;
}

const { eyebrow, title, accent, intro, image, alt, position = '50% 50%' } = Astro.props;
---

<section class="page-hero on-dark" aria-labelledby="page-title">
  <Picture
    src={image}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    widths={[640, 960, 1280, 1600]}
    sizes="100vw"
    alt={alt}
    class="page-hero-img"
    loading="eager"
    fetchpriority="high"
    quality={72}
    style={`object-position:${position}`}
  />
  <div class="shade" aria-hidden="true"></div>
  <div class="inner wrap">
    <p class="eyebrow">{eyebrow}</p>
    <h1 id="page-title" class="h1">
      {title}
      {accent && <><br /><em>{accent}</em></>}
    </h1>
    <p class="intro">{intro}</p>
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: clamp(480px, 72svh, 720px);
    background: var(--forest-950);
    color: var(--on-dark);
    overflow: hidden;
  }

  .page-hero :global(picture),
  .page-hero :global(.page-hero-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
  }

  .page-hero :global(.page-hero-img) {
    object-fit: cover;
  }

  .shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(0deg, rgb(20 26 18 / 0.88) 0%, rgb(20 26 18 / 0.45) 50%, rgb(20 26 18 / 0.25) 100%),
      linear-gradient(90deg, rgb(20 26 18 / 0.5) 0%, rgb(20 26 18 / 0) 65%);
  }

  .inner {
    align-self: end;
    padding-top: calc(var(--header-h) + 3rem);
    padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .inner > * {
    max-width: 44rem;
  }

  h1 {
    margin-top: 1.1rem;
  }

  .intro {
    margin-top: 1.4rem;
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--on-dark-soft);
    max-width: 36rem;
  }
</style>
